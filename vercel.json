{
  "framework": null,
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "build/web",
  "functions": {"api/[route].js": {"maxDuration": 60, "includeFiles": "assets/hono_client_protocol.json"}},
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"same-origin"},{"key":"Permissions-Policy","value":"camera=(self), microphone=(), geolocation=(self)"}]},
    {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]} 
  ],
  "rewrites": [{"source":"/((?!api/|vision/|assets/|canvaskit/|icons/|.*\\.).*)","destination":"/index.html"}]
}
